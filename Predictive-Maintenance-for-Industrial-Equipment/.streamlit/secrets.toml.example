# Copy to .streamlit/secrets.toml for local use (that file is git-ignored),
# or paste the same keys in Streamlit Cloud -> App settings -> Secrets.
SLACK_WEBHOOK_URL = "https://hooks.slack.com/services/XXX/YYY/ZZZ"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "you@gmail.com"
SMTP_PASSWORD = "your-app-password"
ALERT_FROM = "you@gmail.com"
ALERT_TO = "maintenance-team@example.com"
